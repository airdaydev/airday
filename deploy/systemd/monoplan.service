[Unit]
Description=Monoplan server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=monoplan
Group=monoplan
Environment=PATH=/usr/local/bin:/usr/bin:/bin
WorkingDirectory=/opt/monoplan/current
ExecStart=/opt/monoplan/current/target/release/monoplan-server --config /etc/monoplan/server.toml
Restart=always
RestartSec=5

# Sandboxing — sqlite db lives in /var/lib/monoplan so that's the only
# writable path the unit needs.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/monoplan

[Install]
WantedBy=multi-user.target
