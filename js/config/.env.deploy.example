# Deploy secrets file. Lives at /opt/monoplan/.env on the server (mode 0600,
# owned by monoplan:monoplan). Read by `bun run config:deploy` during ci.sh.
#
# Copy this to /opt/monoplan/.env and fill in the required values.

# Public hostname Caddy serves on. Caddy will provision a Let's Encrypt
# certificate via HTTP-01 — make sure 80/443 are reachable from the
# internet and DNS already points here before deploying.
MONOPLAN_HOST=monoplan.example.com

# Account email for Let's Encrypt registration / renewal notices.
CADDY_EMAIL=you@example.com

# ---- optional overrides — defaults shown ------------------------------

# Bind address for monoplan-server. Loopback only — Caddy reverse-proxies.
# MONOPLAN_BIND=127.0.0.1:8000

# Sqlite path. Must be inside /var/lib/monoplan (the systemd unit's only
# writable path) unless you also widen ReadWritePaths in monoplan.service.
# MONOPLAN_DB_PATH=/var/lib/monoplan/monoplan.sqlite

# MONOPLAN_LOG_LEVEL=info

# Set the Secure attribute on the device-auth cookie. Must be true behind
# Caddy's TLS — only flip to false for plain-HTTP alpha.
# MONOPLAN_SECURE_COOKIES=true

# Argon2id PHC hash enabling GET /admin/stats. Leave unset to keep all
# admin routes disabled. Generate with `monoplan-server hash-admin-password`.
# MONOPLAN_ADMIN_PASSWORD_HASH='$argon2id$v=19$m=19456,t=2,p=1$...'
